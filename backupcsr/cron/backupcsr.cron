# Copias de seguridad (backupcsr) — ubuntu-services.
# Instalar con: install -m 0644 cron/backupcsr.cron /etc/cron.d/backupcsr
#
# Horarios (hora local Colombia, UTC-5): los jobs *-bd corren cada hora (6-19) y
# los *-web 3 veces al día (6, 13 y 19). Si el servidor no está en America/Bogota,
# CRON_TZ lo fuerza.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LANG=C.UTF-8
CRON_TZ=America/Bogota
MAILTO=""

# --- Google y Latino: SFTP con llave -> NAS ---
20 6-19 * * *       root  flock -n /run/lock/backupcsr-google-bd.lock   /opt/backupcsr/jobs/google-bd.sh
20 6-19 * * *       root  flock -n /run/lock/backupcsr-latino-bd.lock   /opt/backupcsr/jobs/latino-bd.sh

# --- NAS local (Ruta56, Gastro, Enter): FTP -> NAS ---
20 6-19 * * *       root  flock -n /run/lock/backupcsr-ruta56-bd.lock   /opt/backupcsr/jobs/ruta56-bd.sh
20 6,13,19 * * *     root  flock -n /run/lock/backupcsr-ruta56-web.lock  /opt/backupcsr/jobs/ruta56-web.sh
20 6-19 * * *        root  flock -n /run/lock/backupcsr-gastro-bd.lock   /opt/backupcsr/jobs/gastro-bd.sh
20 6-19 * * *        root  flock -n /run/lock/backupcsr-enter-bd.lock    /opt/backupcsr/jobs/enter-bd.sh
