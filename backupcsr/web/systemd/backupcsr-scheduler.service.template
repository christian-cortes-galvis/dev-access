[Unit]
Description=Planificador de copias backupcsr (concurrencia controlada y reintentos)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__WEB_DIR__
EnvironmentFile=/etc/backupcsr/web.env
ExecStartPre=/bin/mkdir -p /run/backupcsr /var/lib/backupcsr
ExecStart=__WEB_DIR__/venv/bin/python -m app.scheduler
Restart=on-failure
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
