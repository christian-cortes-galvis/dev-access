# Credenciales de las copias de seguridad.
# Copiar a /etc/backupcsr/credentials.env, reemplazar cada CAMBIAR y aplicar:
#   chown root:root /etc/backupcsr/credentials.env
#   chmod 600 /etc/backupcsr/credentials.env
#
# Los valores se toman de texts/script_*.txt, donde estaban en texto plano.
# Nota: si una clave contiene espacios, #, $ o comillas, escribirla entre comillas simples.

# --- Google (SFTP con llave privada; la llave va en /etc/backupcsr/keys/google) ---
GOOGLE_BD_HOST=35.185.102.160
GOOGLE_BD_PORT=22
GOOGLE_BD_USER=administrador

GOOGLE_WEB_HOST=35.229.110.253
GOOGLE_WEB_PORT=22
GOOGLE_WEB_USER=administrador

# --- Latino (SFTP con llave privada; llave en /etc/backupcsr/keys/latino) ---
LATINO_HOST=158.106.128.218
LATINO_PORT=2200
LATINO_USER=chequeos
# Opcional: respaldo si la llave /etc/backupcsr/keys/latino no funcionara (SFTP con sshpass).
# LATINO_PASS=CAMBIAR

