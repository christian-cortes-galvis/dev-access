# Certificados locales de mkcert: nunca versionar (incluye la llave privada).
certs/
*.pem
*.key

# Datos runtime de portal-api (SQLite). Se recrea desde backend/catalog.yml.
backend/data/

# Secretos de monitoring (clave admin de Grafana). Usar .env.example como plantilla.
.env

# Python
__pycache__/
*.pyc
.kilo

# backupcsr: secretos y llaves locales (nunca versionar; solo los .example).
backupcsr/conf/*.env
backupcsr/conf/*.creds
backupcsr/conf/fstab.backupcsr
backupcsr/keys/
*.ppk
